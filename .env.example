# ── OpenRouter ───────────────────────────────────────────────────────
# openrouter.ai/keys — used with free Nemotron models (nvidia/nemotron-*:free),
# so this costs $0 as configured. The `openai` SDK talks to OpenRouter directly
# via a custom baseURL (see src/config.ts).
OPENROUTER_API_KEY=sk-or-v1-...

# ── Slack ────────────────────────────────────────────────────────────
# Bot token (xoxb-). Scopes: channels:history, chat:write, channels:read
# Remember to /invite the bot into the channel.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# ── PostHog ──────────────────────────────────────────────────────────
# Personal API key (phx_...), NOT the project write key (phc_...)
POSTHOG_API_KEY=phx_...
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://us.posthog.com

# ── Linear ───────────────────────────────────────────────────────────
# Settings -> API -> Personal API keys
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=

# ── Repo under investigation ─────────────────────────────────────────
# Local path to a checkout of the app the bug was reported against.
REPO_PATH=../acme-shop
