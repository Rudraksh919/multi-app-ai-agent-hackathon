# ── OpenRouter ───────────────────────────────────────────────────────
# openrouter.ai/keys — used with free Nemotron models (nvidia/nemotron-*:free),
# so this costs $0 as configured. The `openai` SDK talks to OpenRouter directly
# via a custom baseURL (see src/config.ts).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: comma-separated keys (e.g. from separate free-tier accounts) to fail over
# across on "service temporarily overloaded" — every LLM call tries them in order until
# one answers. Takes priority over OPENROUTER_API_KEY above if set. See src/agent/client.ts.
# OPENROUTER_API_KEYS=sk-or-v1-aaa...,sk-or-v1-bbb...,sk-or-v1-ccc...

# ── Slack ────────────────────────────────────────────────────────────
# Bot token (xoxb-). Scopes: channels:history, chat:write, channels:read, reactions:read
# (reactions:read is needed for the "implement this fix?" approval poll).
# Remember to /invite the bot into the channel.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# ── PostHog ──────────────────────────────────────────────────────────
# Personal API key (phx_...), NOT the project write key (phc_...)
POSTHOG_API_KEY=phx_...
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://us.posthog.com

# ── Sentry (optional) ───────────────────────────────────────────────
# Only needed if the target codebase uses Sentry — bisect-skills routing decides whether
# to query it per bug. Unset = the sentry_* tools tell the agent it isn't configured rather
# than error. Settings -> Auth Tokens (needs project:read, event:read scopes).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_HOST=https://sentry.io

# ── Linear ───────────────────────────────────────────────────────────
# Settings -> API -> Personal API keys
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=

# ── Repo under investigation ─────────────────────────────────────────
# Either GITHUB_REPO (bisect clones it fresh via git — works on any repo the token can
# read) or REPO_PATH (a plain local checkout, for local dev). GITHUB_REPO wins if both
# are set. See src/repo/resolve.ts.
GITHUB_REPO=
GITHUB_BASE_BRANCH=
GITHUB_TOKEN=
REPO_PATH=../acme-shop

# ── PR review (src/pr-review/) ──────────────────────────────────────────
# Secret configured on the GitHub webhook (Settings -> Webhooks -> this repo's PR events).
# Requests without a valid HMAC signature are rejected — never leave this unset in a deployed
# instance. GITHUB_TOKEN above is reused to fetch diffs, clone the PR branch, and post the
# verdict comment; it needs `repo` scope (or Contents: Read + Pull requests: Read & Write for
# a fine-grained token).
GITHUB_WEBHOOK_SECRET=
PR_REVIEW_PORT=4322
