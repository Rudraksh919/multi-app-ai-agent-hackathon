{
  "name": "bisect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent that investigates bug reports using real user sessions, not guesses.",
  "scripts": {
    "setup": "tsx src/setup/wizard.ts",
    "dev": "tsx watch src/bisect/index.ts",
    "start": "tsx src/bisect/index.ts",
    "once": "tsx src/bisect/index.ts --once",
    "typecheck": "tsc --noEmit",
    "ui": "tsx src/bisect/ui/server.ts",
    "bench": "tsx benchmark/run.ts",
    "review": "tsx src/pr-manager/server.ts",
    "review:pr": "tsx src/pr-manager/server.ts --pr",
    "setup:github-app": "tsx src/pr-manager/setupGithubApp.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "openai": "^6.9.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.1",
    "typescript": "^5.9.3"
  }
}
